# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for FMP market-data warehouse writes
SUPABASE_SERVICE_ROLE_KEY=

# Financial Modeling Prep — primary equities fundamentals / market data for Analysis
FMP_API_KEY=
# FMP_API_BASE=https://financialmodelingprep.com/stable

# Optional: enable Yahoo as last-resort fundamentals fill (default off; FMP warehouse is primary)
# MARKET_DATA_YAHOO_FALLBACK=1

# OpenRouter — server-only AI (Analysis blurbs, chat assistant)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: force every AI_FEATURES model while testing (intentional override, not a failure fallback)
# AI_MODEL_OVERRIDE=google/gemini-2.5-flash
# Optional: narrative / Future Outlook model only (otherwise AI_FEATURES.analysis.narrative_bundle)
# NARRATIVE_MODEL=x-ai/grok-4.6
# AI_MODEL_NARRATIVE=x-ai/grok-4.6
# Optional: narrative LLM timeout in ms (clamped 30000–180000, default 90000)
# NARRATIVE_TIMEOUT_MS=90000
