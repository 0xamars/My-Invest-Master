# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for FMP market-data warehouse writes
SUPABASE_SERVICE_ROLE_KEY=

# Financial Modeling Prep — primary equities fundamentals / market data for Analysis
FMP_API_KEY=
# FMP_API_BASE=https://financialmodelingprep.com/stable

# Optional: enable Yahoo as last-resort fundamentals fill (default off; FMP warehouse is primary)
# MARKET_DATA_YAHOO_FALLBACK=1

# Plaid — Budget bank link (optional). App runs without these.
# Sandbox default. Amar: create an app at https://dashboard.plaid.com
# Products: Transactions. Webhook: https://<prod-domain>/api/plaid/webhook
# Redirect URI (OAuth banks): https://<prod-domain>/budget
PLAID_CLIENT_ID=
PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=https://your-domain/api/plaid/webhook
# PLAID_REDIRECT_URI=https://your-domain/budget

# OpenRouter — server-only AI. Required in Vercel Production for the Analysis
# left pane (InvestSalsa Summary + Future opportunities + Key risks).
# Without this key the pane shows a grounded fallback; scores stay FMP-only.
# Amar: if Production is missing this, add OPENROUTER_API_KEY in Vercel after
# 12:00 America/Toronto (do not commit the secret).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: force every AI_FEATURES model while testing (intentional override, not a failure fallback)
# AI_MODEL_OVERRIDE=google/gemini-2.5-flash
# Optional: narrative / Future Outlook model only (otherwise AI_FEATURES.analysis.narrative_bundle = x-ai/grok-4.6)
# NARRATIVE_MODEL=x-ai/grok-4.6
# AI_MODEL_NARRATIVE=x-ai/grok-4.6
# Optional: narrative LLM timeout in ms (clamped 30000–180000, default 90000)
# NARRATIVE_TIMEOUT_MS=90000
